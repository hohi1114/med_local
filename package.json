{
  "name": "med_local",
  "private": true,
  "version": "0.0.5",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"vite --mode development\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "build:bundle": "vite build && tsc -p tsconfig.electron.json",
    "dist": "vite build && npm run build-electron && electron-builder",
    "dist:mac": "npm run build:bundle && CSC_IDENTITY_AUTO=false electron-builder --mac dmg zip",
    "build-electron": "tsc -p tsconfig.electron.json"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "HTRACKER",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "public/logo.icns"
    },
    "linux": {
      "target": null
    }
  },
  "dependencies": {
    "@ant-design/charts": "^2.2.7",
    "@tanstack/react-query": "^5.67.3",
    "@vanilla-extract/css": "^1.17.1",
    "@vanilla-extract/dynamic": "^2.1.2",
    "antd": "^5.24.2",
    "axios": "^1.8.2",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "electron-is-dev": "^3.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "iconv-lite": "^0.7.0",
    "idb": "^8.0.2",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "openai": "^6.15.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-cookie": "^7.2.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.5.1",
    "styled-components": "^6.1.15",
    "systeminformation": "^5.25.11",
    "timezone": "^1.0.23",
    "utc": "^0.1.0",
    "vite-plugin-vanilla-extract": "^0.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-deb": "^7.7.0",
    "@electron-forge/maker-rpm": "^7.7.0",
    "@electron-forge/maker-squirrel": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.7.0",
    "@electron-forge/plugin-fuses": "^7.7.0",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.21.0",
    "@faker-js/faker": "^9.6.0",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/leaflet": "^1.9.21",
    "@types/lodash": "^4.17.16",
    "@types/navermaps": "^3.7.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@types/styled-components": "^5.1.34",
    "@vanilla-extract/vite-plugin": "^5.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
